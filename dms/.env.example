# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values. docker-compose reads .env automatically -- never commit the
# real .env file to git.

# MySQL root password (also used by the app to connect)
DB_PASSWORD=change_this_to_a_strong_password

# Required -- app refuses to start without this. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_random_32plus_character_value

# Optional -- only needed if you want password-reset emails to actually send
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional -- used to build links inside password-reset emails.
# Set this to your real public domain once you have one, e.g. https://dms.yourcompany.com
APP_FRONTEND_BASE_URL=http://localhost:8080
